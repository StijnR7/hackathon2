@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="text-center py-5">
    <p class="display-4 fw-bold text-warning">@Model.StatusCode</p>
    <h1 class="h3">@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Foutcode voor de helpdesk: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-warning" asp-controller="Home" asp-action="Index">Terug naar rit plannen</a>
</div>
