@model Taxi

<div class="d-flex align-items-center gap-3">
    <div class="plate" aria-label="Kenteken">@Model.LicensePlate</div>
    <div class="small">
        <div class="fw-semibold">@Model.VehicleDescription</div>
        <div class="text-muted">
            Chauffeur @Model.Driver.FirstName &middot; vergunning @Model.Driver.LicenseNumber
            &middot; <span aria-label="beoordeling">&#9733; @Formatting.Number(Model.Driver.Rating)</span>
        </div>
    </div>
</div>
