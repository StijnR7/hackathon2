{
  "ConnectionStrings": {
    "HitchTracker": "Data Source=hitchtracker.db"
  },
  "Routing": {
    "Provider": "Osrm",
    "OsrmBaseUrl": "https://router.project-osrm.org/",
    "TimeoutSeconds": 8,
    "OfflineAverageSpeedKmh": 25
  },
  "Monitoring": {
    "OffRouteThresholdMeters": 100,
    "BackOnRouteThresholdMeters": 50,
    "TrafficMarginFactor": 1.4,
    "RerouteIntervalSeconds": 15,
    "MaxPlausibleSpeedKmh": 200,
    "MinimumTripDistanceMeters": 200
  },
  "Simulation": {
    "Enabled": true,
    "TickMilliseconds": 1000,
    "SpeedFactor": 10
  },
  "DataRetention": {
    "Enabled": true,
    "PositionRetentionDays": 30,
    "TripRetentionDays": 90,
    "PlannedTripRetentionHours": 24,
    "IntervalHours": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
